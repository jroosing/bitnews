package web

// StyleguidePage is the living style guide: every component and state of the
// design system, and the visual test page.
templ StyleguidePage(v *View, g styleguide) {
	@AppLayout(v, styleguideSubtitle(), nil) {
		<div class="space-y-10" data-styleguide>
			<section aria-labelledby="sg-colors" class="space-y-3">
				<h2 id="sg-colors" class="text-lg">Colour tokens</h2>
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
					for _, sw := range g.Swatches {
						<div class="overflow-hidden rounded-xl border border-line bg-surface">
							<div class={ "h-14", sw.Class }></div>
							<p class="px-3 py-2 text-xs font-medium text-fg">{ sw.Name }</p>
						</div>
					}
				</div>
			</section>
			<section aria-labelledby="sg-type" class="space-y-3">
				<h2 id="sg-type" class="text-lg">Typography</h2>
				@Card(CardProps{}) {
					<p class="text-3xl font-semibold tracking-tight">Display 3xl semibold</p>
					<h3 class="mt-3 text-xl">Heading xl</h3>
					<p class="mt-2">Body text in Inter at 14 px. The quick brown fox jumps over the lazy dog.</p>
					<p class="mt-1 text-fg-muted">Muted text for descriptions and secondary information.</p>
					<p class="mt-1 text-fg-subtle">Subtle text for hints and placeholders.</p>
					<p class="mt-3 tabular-nums">Tabular numbers: 1,234,567.89 &nbsp; 12.5 MB/s &nbsp; 00:42:07</p>
					<p class="mt-3"><a href="#sg-type">An inline link</a>{ " and " }<code class="rounded bg-surface-2 px-1.5 py-0.5 text-xs">inline code</code>.</p>
				}
			</section>
			<section aria-labelledby="sg-buttons" class="space-y-3">
				<h2 id="sg-buttons" class="text-lg">Buttons</h2>
				@Card(CardProps{}) {
					<div class="flex flex-wrap items-center gap-3">
						@Button(ButtonProps{Label: "Primary", Variant: ButtonPrimary})
						@Button(ButtonProps{Label: "Secondary", Variant: ButtonSecondary})
						@Button(ButtonProps{Label: "Danger", Variant: ButtonDanger})
						@Button(ButtonProps{Label: "Ghost", Variant: ButtonGhost})
						@Button(ButtonProps{Label: "Disabled", Disabled: true})
					</div>
					<div class="mt-4 flex flex-wrap items-center gap-3">
						@Button(ButtonProps{Label: "Small", Size: ButtonSmall, Variant: ButtonSecondary})
						@Button(ButtonProps{Label: "Default", Variant: ButtonSecondary})
						@Button(ButtonProps{Label: "Large", Size: ButtonLarge})
						@Button(ButtonProps{Label: "With icon", Icon: IconPlus})
						@Button(ButtonProps{Label: "Add download", Icon: IconPlus, IconOnly: true, Variant: ButtonSecondary})
						@Button(ButtonProps{Label: "Delete", Icon: IconTrash, IconOnly: true, Variant: ButtonGhost})
					</div>
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<div class="htmx-request">
							@Button(ButtonProps{Label: "Loading (htmx-request)", Loading: true})
						</div>
						@Button(ButtonProps{Label: "Pause all", Icon: IconPause, Variant: ButtonSecondary, Size: ButtonSmall})
						@Button(ButtonProps{Label: "Resume", Icon: IconPlay, Variant: ButtonSecondary, Size: ButtonSmall})
					</div>
				}
			</section>
			<section aria-labelledby="sg-forms" class="space-y-3">
				<h2 id="sg-forms" class="text-lg">Form controls</h2>
				@Card(CardProps{Title: "Example form", Subtitle: "Labels, help, errors and every control type"}) {
					<form class="grid gap-5 sm:grid-cols-2" action="#" data-demo-form>
						@Field(FieldProps{ID: "sg-text", Label: "Text input", Placeholder: "download-name", Help: "Help text sits under the control."})
						@Field(FieldProps{ID: "sg-error", Label: "With an error", Value: "not-a-number", Error: "Enter a whole number between 1 and 50."})
						@Field(FieldProps{ID: "sg-password", Label: "Password", Type: FieldPassword, Value: "hunter2", Help: "The eye button reveals it (JavaScript only)."})
						@SelectField(SelectProps{ID: "sg-select", Label: "Select", Selected: "normal", Options: g.Options})
						@Field(FieldProps{ID: "sg-disabled", Label: "Disabled", Value: "read only", Disabled: true})
						@Field(FieldProps{ID: "sg-optional", Label: "Optional field", Optional: true})
						<div class="space-y-4 sm:col-span-2">
							@CheckboxField(CheckProps{ID: "sg-check", Label: "Delete data when removing", Help: "Also removes the files on disk.", Checked: true})
							@CheckboxField(CheckProps{ID: "sg-check2", Label: "Unchecked option"})
							@SwitchField(CheckProps{ID: "sg-switch", Label: "Enable DHT", Help: "Find peers without a tracker.", Checked: true})
							@SwitchField(CheckProps{ID: "sg-switch2", Label: "Enable LAN bypass", Help: "Skips sign-in for the networks you list."})
						</div>
					</form>
				}
			</section>
			<section aria-labelledby="sg-badges" class="space-y-3">
				<h2 id="sg-badges" class="text-lg">Badges and progress</h2>
				@Card(CardProps{}) {
					<div class="flex flex-wrap gap-3">
						for _, state := range g.States {
							@Badge(state, "")
						}
					</div>
					<div class="mt-6 grid gap-5 sm:grid-cols-2">
						@Progress(ProgressProps{Value: 12, Label: "Downloading 12 percent", Show: true})
						@Progress(ProgressProps{Value: 64, Label: "Downloading 64 percent", Show: true})
						@Progress(ProgressProps{Value: 100, Label: "Ready", Variant: ProgressOK, Show: true})
						@Progress(ProgressProps{Value: 38, Label: "Paused at 38 percent", Variant: ProgressWarn, Show: true})
						@Progress(ProgressProps{Value: 71, Label: "Failed at 71 percent", Variant: ProgressBad, Show: true})
					</div>
				}
			</section>
			<section aria-labelledby="sg-alerts" class="space-y-3">
				<h2 id="sg-alerts" class="text-lg">Alerts</h2>
				<div class="space-y-3">
					@Alert(AlertProps{Variant: AlertInfo, Title: "Heads up", Body: "Informational message with some detail."})
					@Alert(AlertProps{Variant: AlertSuccess, Title: "Saved", Body: "Your settings were saved."})
					@Alert(AlertProps{Variant: AlertWarn, Title: "Careful", Body: "A change to the folders affects only new downloads."})
					@Alert(AlertProps{Variant: AlertDanger, Title: "Something failed", Body: "The server refused the connection."})
				</div>
			</section>
			<section aria-labelledby="sg-table" class="space-y-3">
				<h2 id="sg-table" class="text-lg">Table (cards below 768 px)</h2>
				@TableShell("Example downloads", "") {
					<thead><tr><th scope="col">Name</th><th scope="col">State</th><th scope="col" class="num">Size</th><th scope="col" class="num">Speed</th><th scope="col">Progress</th></tr></thead>
					<tbody>
						for _, r := range g.Rows {
							<tr>
								<td data-label="Name" class="max-w-xs truncate font-medium">{ r.Name }</td>
								<td data-label="State">
									@Badge(r.State, "")
								</td>
								<td data-label="Size" class="num">{ r.Size }</td>
								<td data-label="Speed" class="num">{ r.Speed }</td>
								<td data-label="Progress" class="md:w-48">
									@Progress(ProgressProps{Value: r.Percent, Label: "Progress"})
								</td>
							</tr>
						}
					</tbody>
				}
				<div class="pt-2">
					@Pagination(PaginationProps{Summary: "Showing 4 of 4 downloads", NextHref: "#sg-table"})
				</div>
			</section>
			<section aria-labelledby="sg-empty" class="space-y-3">
				<h2 id="sg-empty" class="text-lg">Empty state</h2>
				@Card(CardProps{NoPad: true}) {
					@EmptyState(EmptyProps{Icon: IconInbox, Title: "Nothing here yet", Body: "Empty states explain what will appear and how to get started.", ActionLabel: "Go to the queue", ActionHref: "/queue"})
				}
			</section>
			<section aria-labelledby="sg-overlays" class="space-y-3">
				<h2 id="sg-overlays" class="text-lg">Dialogs, toasts and menus</h2>
				@Card(CardProps{}) {
					<div class="flex flex-wrap items-center gap-3" x-data="toastDemo">
						<div x-data="modal">
							<button type="button" class="btn btn-secondary" @click="show">Open dialog</button>
							@Modal(ModalProps{ID: "sg-dialog", Title: "Dialog title", Description: "A native dialog: Escape closes it and focus is trapped."}) {
								<div class="flex justify-end gap-2">
									<button type="button" class="btn btn-secondary" @click="hide">Cancel</button>
									<button type="button" class="btn btn-primary" @click="hide">Save</button>
								</div>
							}
						</div>
						<button type="button" class="btn btn-secondary" data-level="success" @click="fire">Success toast</button>
						<button type="button" class="btn btn-secondary" data-level="info" @click="fire">Info toast</button>
						<button type="button" class="btn btn-secondary" data-level="warn" @click="fire">Warning toast</button>
						<button type="button" class="btn btn-secondary" data-level="danger" @click="fire">Error toast</button>
						@CopyButton("https://bitnews.example/api")
					</div>
				}
			</section>
			<section aria-labelledby="sg-tabs" class="space-y-3">
				<h2 id="sg-tabs" class="text-lg">Tabs</h2>
				@Card(CardProps{}) {
					<div x-data="tabs">
						<div class="flex gap-6 border-b border-line" role="tablist" aria-label="Example tabs">
							<button type="button" role="tab" class="tab" data-tab="general" :aria-selected="isActive('general')" @click="select">General</button>
							<button type="button" role="tab" class="tab" data-tab="network" :aria-selected="isActive('network')" @click="select">Network</button>
							<button type="button" role="tab" class="tab" data-tab="security" :aria-selected="isActive('security')" @click="select">Security</button>
						</div>
						<div role="tabpanel" class="pt-4 text-fg-muted" x-show="isActive('general')">General settings go here.</div>
						<div role="tabpanel" class="pt-4 text-fg-muted" x-show="isActive('network')" x-cloak>Network settings go here.</div>
						<div role="tabpanel" class="pt-4 text-fg-muted" x-show="isActive('security')" x-cloak>Security settings go here.</div>
					</div>
				}
			</section>
			<section aria-labelledby="sg-icons" class="space-y-3">
				<h2 id="sg-icons" class="text-lg">Icons</h2>
				@Card(CardProps{}) {
					<ul class="grid grid-cols-3 gap-4 sm:grid-cols-6 lg:grid-cols-8">
						for _, name := range g.Icons {
							<li class="flex flex-col items-center gap-1.5 text-center text-xs text-fg-muted">
								@Icon(name, "size-6 text-fg")
								<span>{ string(name) }</span>
							</li>
						}
					</ul>
				}
			</section>
		</div>
	}
}

templ styleguideSubtitle() {
	<p class="mt-1 text-sm text-fg-muted">Every component and state of the bitnews design system. Also the visual test page.</p>
}
