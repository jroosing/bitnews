package web

import "strconv"

// htmxConfig is the content of <meta name="htmx-config"> (ADR-0005): no
// eval, no script tags, same-origin requests only, no history cache.
const htmxConfig = `{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true,"includeIndicatorStyles":false,"attributesToSettle":["class","width","height"],"historyCacheSize":0,"refreshOnHistoryMiss":true,"scrollBehavior":"auto","defaultFocusScroll":false,"timeout":30000,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true,"error":false},{"code":"429","swap":true,"error":false},{"code":"[45]..","swap":false,"error":true}]}`

// Head is the document head of every full page.
templ Head(v *View) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="light dark"/>
	<meta name="referrer" content="same-origin"/>
	<meta name="htmx-config" content={ htmxConfig }/>
	if v.CSRF != "" {
		<meta name="csrf-token" content={ v.CSRF }/>
	}
	<title>
		if v.Title != "" {
			{ v.Title + " · " }
		}
		bitnews
	</title>
	<link rel="icon" href={ v.Head.Favicon } type="image/svg+xml"/>
	<link rel="stylesheet" href={ v.Head.CSS }/>
	<script src={ v.Head.ThemeJS }></script>
	<script src={ v.Head.AppJS } defer></script>
	<script src={ v.Head.QueueJS } defer></script>
	<script src={ v.Head.DetailJS } defer></script>
	<script src={ v.Head.SettingsJS } defer></script>
	<script src={ v.Head.HTMX } defer></script>
	<script src={ v.Head.HTMXSSE } defer></script>
	<script src={ v.Head.Alpine } defer></script>
}

// Brand is the logo and name that link home.
templ Brand() {
	<a href="/queue" class="flex items-center gap-2.5 text-fg no-underline hover:no-underline" aria-label="bitnews home">
		<span class="logo-mark">
			@Icon(IconQueue, "size-5")
		</span>
		<span class="text-lg font-semibold tracking-tight">bitnews</span>
	</a>
}

// Nav is the sidebar list (desktop) or slide-over list (mobile).
templ Nav(n NavData) {
	<nav aria-label={ n.NavLabel } class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
		for _, item := range n.Nav {
			<a
				href={ templ.URL(item.Path) }
				class="nav-link"
				if item.Active {
					aria-current="page"
				}
			>
				@Icon(IconName(item.Icon), "size-5 shrink-0")
				<span>{ item.Label }</span>
			</a>
		}
	</nav>
}

// LiveStatus is the live transfer status. /ui/events replaces the three
// value spans with out-of-band swaps (queue_events.go); keep their ids.
templ LiveStatus() {
	<div id="live-status" class="hidden items-center gap-4 sm:flex" aria-label="Transfer status">
		<span class="inline-flex items-center gap-1.5 text-sm text-fg-muted tabular-nums" title="Download speed">
			@Icon(IconArrowDown, "size-4 text-info-fg")
			<span id="status-down">0 B/s</span>
		</span>
		<span class="inline-flex items-center gap-1.5 text-sm text-fg-muted tabular-nums" title="Upload speed">
			@Icon(IconArrowUp, "size-4 text-ok-fg")
			<span id="status-up">0 B/s</span>
		</span>
		<span id="status-queue" role="status" class="badge badge-queued">Idle</span>
		<span id="live-sink" hidden hx-swap="none" sse-swap="status,live,removed"></span>
	</div>
}

// LiveStatusOOB is the top bar's values as out-of-band swaps, sent by the
// live stream. The ids are the ones in LiveStatus.
templ LiveStatusOOB(st liveStatus) {
	<span id="status-down" hx-swap-oob="true">{ st.Down }</span>
	<span id="status-up" hx-swap-oob="true">{ st.Up }</span>
	<span id="status-queue" hx-swap-oob="true" role="status" class={ "badge badge-" + st.Badge }>{ st.Label }</span>
}

// AccountMenu is the account menu with the theme choice and sign-out.
templ AccountMenu(m UserMenu) {
	<div x-data="menu" class="relative" @keydown.escape="close" @click.outside="closeQuiet">
		<button type="button" x-ref="button" @click="toggle" @keydown="onButtonKey" class="btn btn-ghost gap-2 pr-2.5 pl-1.5" aria-haspopup="menu" :aria-expanded="open" aria-label="Account menu">
			<span class="inline-flex size-7 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent-soft-fg uppercase" aria-hidden="true">{ m.Initial }</span>
			<span class="hidden max-w-32 truncate sm:inline">{ m.UserLabel }</span>
			@Icon(IconChevronDown, "size-4 text-fg-subtle")
		</button>
		<div x-ref="panel" x-show="open" x-cloak x-transition.opacity.duration.100ms class="menu-panel" role="menu" aria-label="Account" @keydown="onPanelKey">
			<div class="px-3 pt-2 pb-1">
				<p class="truncate text-sm font-medium text-fg">{ m.UserLabel }</p>
				<p class="text-xs text-fg-subtle">{ m.ModeLabel }</p>
			</div>
			<div class="menu-sep"></div>
			<div x-data="themeChoice">
				<p class="menu-label" id="theme-label">Theme</p>
				<button type="button" role="menuitemradio" class="menu-item" @click="setLight" :aria-checked="isLight">
					@Icon(IconSun, "size-5 text-fg-subtle")
					<span class="flex-1">Light</span>
					<span x-show="isLight" x-cloak class="text-accent-text">
						@Icon(IconCheck, "size-4")
					</span>
				</button>
				<button type="button" role="menuitemradio" class="menu-item" @click="setDark" :aria-checked="isDark">
					@Icon(IconMoon, "size-5 text-fg-subtle")
					<span class="flex-1">Dark</span>
					<span x-show="isDark" x-cloak class="text-accent-text">
						@Icon(IconCheck, "size-4")
					</span>
				</button>
				<button type="button" role="menuitemradio" class="menu-item" @click="setSystem" :aria-checked="isSystem">
					@Icon(IconDesktop, "size-5 text-fg-subtle")
					<span class="flex-1">System</span>
					<span x-show="isSystem" x-cloak class="text-accent-text">
						@Icon(IconCheck, "size-4")
					</span>
				</button>
			</div>
			if m.CanSignOut {
				<div class="menu-sep"></div>
				<form method="post" action="/logout">
					@CSRFField(m.CSRF)
					<button type="submit" role="menuitem" class="menu-item">
						@Icon(IconSignOut, "size-5 text-fg-subtle")
						{ "Sign out" }
					</button>
				</form>
			}
		</div>
	</div>
}

func liveEventsPath(path string) string {
	if path == "/queue" {
		return "/ui/events?rows=1"
	}
	return "/ui/events"
}

// AppLayout is the shell of every page behind the sign-in: sidebar, top bar,
// banner and the global dialogs. subtitle and actions are optional slots
// (nil is fine); the page content is the children.
templ AppLayout(v *View, subtitle, actions templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head(v)
		</head>
		<body class="min-h-dvh" { Hx{Ext: "sse", SSEConnect: liveEventsPath(v.Path)}.MustAttrs()... }>
			<a class="skip-link" href="#main">Skip to main content</a>
			<div x-data="shell" @keydown.escape.window="closeNav">
				<div x-show="navOpen" x-cloak class="relative z-50 lg:hidden" role="dialog" aria-modal="true" aria-label="Navigation">
					<div class="fixed inset-0 bg-black/50" x-show="navOpen" x-transition.opacity @click="closeNav"></div>
					<div
						class="fixed inset-y-0 left-0 flex w-72 max-w-[85vw] flex-col border-r border-line bg-surface shadow-pop"
						x-show="navOpen"
						x-transition:enter="transition duration-200 ease-out"
						x-transition:enter-start="-translate-x-full"
						x-transition:enter-end="translate-x-0"
						x-transition:leave="transition duration-150 ease-in"
						x-transition:leave-start="translate-x-0"
						x-transition:leave-end="-translate-x-full"
					>
						<div class="flex h-14 items-center justify-between px-4">
							@Brand()
							<button type="button" x-ref="navClose" class="btn btn-ghost btn-icon" @click="closeNav" aria-label="Close navigation">
								@Icon(IconClose, "size-5")
							</button>
						</div>
						@Nav(v.NavMobile)
					</div>
				</div>
				<aside class="hidden border-r border-line bg-surface lg:fixed lg:inset-y-0 lg:z-40 lg:flex lg:w-64 lg:flex-col">
					<div class="flex h-14 items-center border-b border-line px-5">
						@Brand()
					</div>
					@Nav(v.NavDesktop)
					<div class="border-t border-line px-5 py-3 text-xs text-fg-subtle">bitnews { v.Version }</div>
				</aside>
				<div class="lg:pl-64">
					<header class="sticky top-0 z-30 flex h-14 items-center gap-2 border-b border-line bg-surface/85 px-4 backdrop-blur sm:px-6">
						<button type="button" class="btn btn-ghost btn-icon -ml-2 lg:hidden" @click="openNav" :aria-expanded="navOpen" aria-label="Open navigation">
							@Icon(IconMenu, "size-5")
						</button>
						<div class="lg:hidden">
							@Brand()
						</div>
						<div class="ml-auto flex items-center gap-3">
							@LiveStatus()
							<button type="button" class="btn btn-primary btn-sm" data-add-open aria-haspopup="dialog">
								@Icon(IconPlus, "size-4")
								<span class="hidden sm:inline">New download</span>
								<span class="sr-only sm:hidden">New download</span>
							</button>
							@AccountMenu(v.UserMenu)
						</div>
					</header>
					@AuthBanner(v.AuthMode)
					<main id="main" tabindex="-1" class="mx-auto w-full max-w-7xl px-4 py-6 focus:outline-none sm:px-6 lg:px-8">
						<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
							<div class="min-w-0">
								<h1 class="text-2xl break-words">{ v.Title }</h1>
								if subtitle != nil {
									@subtitle
								}
							</div>
							<div class="flex items-center gap-2">
								if actions != nil {
									@actions
								}
							</div>
						</div>
						{ children... }
					</main>
				</div>
				@ToastRegion()
				@ConfirmDialog()
				@AddDialog()
			</div>
		</body>
	</html>
}

// BareLayout is the shell of the pages without navigation: sign-in, setup
// and errors.
templ BareLayout(v *View) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head(v)
		</head>
		<body class="auth-backdrop min-h-dvh">
			<a class="skip-link" href="#main">Skip to main content</a>
			<div class="flex min-h-dvh flex-col items-center justify-center px-4 py-10">
				<div class="mb-8 flex flex-col items-center gap-3 text-center">
					<span class="logo-mark size-12 rounded-xl">
						@Icon(IconQueue, "size-7")
					</span>
					<span class="text-2xl font-semibold tracking-tight text-fg">bitnews</span>
				</div>
				<main id="main" tabindex="-1" class="w-full max-w-md focus:outline-none">
					{ children... }
				</main>
				<p class="mt-8 text-xs text-fg-subtle">Usenet and BitTorrent, ready for your media manager.</p>
			</div>
			@ToastRegion()
		</body>
	</html>
}

// ---- add dialog

// AddDialog is the global "New download" dialog, in the layout of every page.
// It opens on the "add-open" window event (the top bar button, see
// js/detail.js) and loads its form from GET /downloads/add each time, so the
// categories are current. AddForm is that form; the server re-renders it with
// the problems when an add is refused.
templ AddDialog() {
	<dialog x-data="addDialog" x-ref="dlg" id="add-dialog" class="modal modal-wide" aria-labelledby="add-dialog-title" aria-describedby="add-dialog-desc" @add-open.window="open" @download-added.window="close" @dragover.prevent @drop.prevent @click="onBackdrop">
		<div class="sticky top-0 z-10 flex items-start justify-between gap-4 rounded-t-2xl border-b border-line bg-surface px-6 py-4">
			<div>
				<h2 id="add-dialog-title" class="text-lg">New download</h2>
				<p id="add-dialog-desc" class="mt-0.5 text-sm text-fg-muted">Add an NZB, a torrent file or a link.</p>
			</div>
			<button type="button" class="btn btn-ghost btn-icon btn-sm -mt-1 -mr-2" @click="close" aria-label="Close the dialog">
				@Icon(IconClose, "size-5")
			</button>
		</div>
		<div id="add-dialog-body" { Hx{Get: "/downloads/add", Trigger: "add-open from:window", Swap: "innerHTML"}.MustAttrs()... }>
			<p class="px-6 py-12 text-center text-sm text-fg-muted">Loading the form...</p>
		</div>
	</dialog>
}

func hasSourceError(f addForm, mode string) bool { return f.SourceError != "" && f.Mode == mode }

func addLinkDescribedBy(f addForm) string {
	if hasSourceError(f, "link") {
		return "add-link-help add-link-error"
	}
	return "add-link-help"
}

// AddForm is the form inside the AddDialog.
templ AddForm(f addForm) {
	<form
		id="add-form"
		method="post"
		action="/downloads/add"
		enctype="multipart/form-data"
		{ Hx{Post: "/downloads/add", Encoding: "multipart/form-data", Target: "#add-dialog-body", Swap: "innerHTML", DisabledElt: "find button[type='submit']"}.MustAttrs()... }
		x-data="addForm"
		data-mode={ f.Mode }
		data-max-bytes={ strconv.FormatInt(f.MaxNZBBytes, 10) }
		data-max-torrent-bytes={ strconv.FormatInt(f.MaxTorrentBytes, 10) }
		data-hint={ f.Hint }
		if f.HasError() {
			data-has-error="1"
		}
		@htmx:before-request="started"
		@htmx:xhr:progress="onProgress"
		@htmx:after-request="finished"
	>
		<input type="hidden" name="mode" :value="mode" value={ f.Mode }/>
		<div class="space-y-5 px-6 py-5">
			if f.Unavailable != "" {
				@Alert(AlertProps{Variant: AlertWarn, Title: "Adding is not available", Body: f.Unavailable})
			} else {
				if f.Error != "" || f.DuplicateID != "" {
					<div id="add-error" tabindex="-1" class="alert alert-danger" role="alert">
						@Icon(IconError, "mt-0.5 size-5 shrink-0")
						<div class="min-w-0">
							if f.DuplicateID != "" {
								<p class="alert-title">Already added</p>
								<p>
									This torrent is already in bitnews
									if f.DuplicateName != "" {
										{ " as " }
										<strong class="break-words">{ f.DuplicateName }</strong>
									}
									{ ". " }
									<a href={ templ.URL("/downloads/" + f.DuplicateID) } class="font-medium underline">Open that download</a>
								</p>
							} else {
								<p>{ f.Error }</p>
							}
						</div>
					</div>
				}
				<div>
					<div class="flex gap-6 border-b border-line" role="tablist" aria-label="What to add">
						<button type="button" role="tab" id="add-tab-file" x-ref="tabFile" class="tab" aria-controls="add-panel-file" :aria-selected="isFile" :tabindex="fileTabIndex" @click="showFile" @keydown="onTabKey">NZB or torrent file</button>
						<button type="button" role="tab" id="add-tab-link" x-ref="tabLink" class="tab" aria-controls="add-panel-link" :aria-selected="isLink" :tabindex="linkTabIndex" @click="showLink" @keydown="onTabKey">Link</button>
					</div>
					<div role="tabpanel" id="add-panel-file" aria-labelledby="add-tab-file" x-show="isFile" class="pt-4">
						<label for="add-file" x-ref="zone" class="dropzone" :class="zoneClass" @dragenter.prevent="dragOver" @dragover.prevent="dragOver" @dragleave.prevent="dragLeave" @drop.prevent="dropped">
							<span class="flex size-11 items-center justify-center rounded-full bg-accent-soft text-accent-soft-fg">
								@Icon(IconUpload, "size-5")
							</span>
							<span class="mt-3 text-sm font-medium text-fg">
								<span x-show="!hasFile">Drop a file here, or <span class="text-accent-text underline">choose one</span></span>
								<span x-show="hasFile" x-cloak class="break-all" x-text="fileName"></span>
							</span>
							<span class="mt-1 text-xs text-fg-muted" x-text="hint">{ f.Hint }</span>
							<input
								id="add-file"
								name="file"
								type="file"
								accept=".nzb,.torrent,application/x-nzb,application/x-bittorrent,text/xml"
								class="sr-only"
								x-ref="file"
								:disabled="isLink"
								@change="picked"
								if hasSourceError(f, "file") {
									aria-invalid="true"
									aria-describedby="add-source-error"
								}
							/>
						</label>
						<p x-show="fileError" x-cloak id="add-file-error" class="field-error" role="alert">
							@Icon(IconError, "mt-px size-4 shrink-0")
							<span x-text="fileError"></span>
						</p>
						if hasSourceError(f, "file") {
							<p id="add-source-error" class="field-error">
								@Icon(IconError, "mt-px size-4 shrink-0")
								<span>{ f.SourceError }</span>
							</p>
						}
					</div>
					<div role="tabpanel" id="add-panel-link" aria-labelledby="add-tab-link" x-show="isLink" x-cloak class="pt-4">
						<label for="add-link" class="label">Magnet link or address</label>
						<input
							id="add-link"
							name="link"
							type="text"
							class="input"
							value={ f.Link }
							placeholder="magnet:?xt=... or https://indexer.example/get/..."
							:disabled="isFile"
							autocomplete="off"
							autocapitalize="none"
							autocorrect="off"
							spellcheck="false"
							inputmode="url"
							aria-describedby={ addLinkDescribedBy(f) }
							if hasSourceError(f, "link") {
								aria-invalid="true"
							}
						/>
						<p id="add-link-help" class="help">A magnet link, or the address of an NZB or a torrent file. bitnews downloads the file for you.</p>
						if hasSourceError(f, "link") {
							<p id="add-link-error" class="field-error">
								@Icon(IconError, "mt-px size-4 shrink-0")
								<span>{ f.SourceError }</span>
							</p>
						}
					</div>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					@Field(FieldProps{ID: "add-name", Name: "name", Label: "Name", Optional: true, Value: f.Name, Placeholder: "Taken from the file", Autocomplete: "off", Error: f.NameError})
					@SelectField(SelectProps{ID: "add-category", Name: "category_id", Label: "Category", Options: f.Categories, Selected: f.Category, Error: f.CategoryError})
					@SelectField(SelectProps{ID: "add-priority", Name: "priority", Label: "Priority", Options: f.Priorities, Selected: f.Priority, Error: f.PriorityError})
					@Field(FieldProps{ID: "add-password", Name: "password", Label: "Archive password", Type: FieldPassword, Optional: true, Autocomplete: "off", Help: "Only for a release whose archives need one.", Error: f.PassError})
				</div>
				@CheckboxField(CheckProps{ID: "add-paused", Name: "paused", Label: "Start paused", Help: "Add it to the queue without starting it.", Checked: f.Paused})
				<div x-show="uploading" x-cloak aria-live="polite">
					<progress class="progress w-full" :value="progress" max="100" aria-label="Upload progress"></progress>
					<p class="mt-1 text-xs text-fg-muted">Uploading... <span x-text="progressText"></span></p>
				</div>
			}
		</div>
		<div class="sticky bottom-0 flex justify-end gap-2 rounded-b-2xl border-t border-line bg-surface-2 px-6 py-4">
			<button type="button" class="btn btn-secondary" @click="closeDialog">Cancel</button>
			if f.Unavailable == "" {
				<button type="submit" class="btn btn-primary">
					<span class="btn-spinner" aria-hidden="true"></span>
					@Icon(IconPlus, "size-4")
					{ "Add download" }
				</button>
			}
		</div>
	</form>
}
