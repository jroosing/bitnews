package web

// SettingsPostprocessingPage is the Post-processing section.
templ SettingsPostprocessingPage(v *View, p settingsPage) {
	{{ views := p.Data.(cardViews) }}
	{{ names := viewOf[cardView](views, "names") }}
	@AppLayout(v, cardsSubtitle(p.Section.Description), nil) {
		@SettingsLayout(p.Nav) {
			@PostprocessingNamesCard(names)
			<p class="px-1 text-sm text-fg-muted">Both apply to the next download. They change nothing about downloads that are already added. The rules are the ones from the TRaSH guides' scripts, built into bitnews: there are no scripts to install.</p>
		}
	}
}

// PostprocessingOptionProps are the parameters of PostprocessingOption.
type PostprocessingOptionProps struct {
	ID, Name, Label, Help string
	Checked               bool
	// When it runs, an example (Before becomes After) and a note.
	When, Before, After, Note string
}

// PostprocessingOption is one option: the switch, then when it runs, an
// example and a note.
templ PostprocessingOption(o PostprocessingOptionProps) {
	<div class="min-w-0 rounded-xl border border-line px-4 py-4">
		@SwitchField(CheckProps{ID: o.ID, Name: o.Name, Label: o.Label, Help: o.Help, Checked: o.Checked})
		<dl class="mt-4 space-y-2 border-t border-line pt-3 text-sm">
			<div>
				<dt class="font-medium text-fg">When it runs</dt>
				<dd class="text-fg-muted">{ o.When }</dd>
			</div>
			<div>
				<dt class="font-medium text-fg">Example</dt>
				<dd class="text-fg-muted"><code class="break-all text-fg">{ o.Before }</code> becomes <code class="break-all text-fg">{ o.After }</code></dd>
			</div>
			<div>
				<dt class="font-medium text-fg">Good to know</dt>
				<dd class="text-fg-muted">{ o.Note }</dd>
			</div>
		</dl>
	</div>
}

// PostprocessingNamesCard is the "Tidy names" card.
templ PostprocessingNamesCard(v cardView) {
	@SettingsForm(SettingsFormProps{
		ID: "postprocessing", Action: "/settings/postprocessing", Title: "Tidy names",
		Subtitle: "Two optional clean-ups for NZB downloads. Both are off until you turn them on.",
		CSRF:     v.CSRF, Error: v.Error, Saved: v.Saved, Dirty: v.Dirty, Label: "Save options",
	}) {
		@PostprocessingOption(PostprocessingOptionProps{
			ID: "clean-names", Name: "clean_names", Label: "Clean release names",
			Help:    "Removes the tags bots add to the end of a release name, such as -NZBGeek, -Obfuscated or [eztv], when an NZB is added.",
			Checked: v.V["clean_names"] != "",
			When:    "As soon as an NZB is added, before anything is downloaded (like SABnzbd's Clean.py pre-queue script from the TRaSH guides).",
			Before:  "Show.S01E01.1080p-GRP-Obfuscated", After: "Show.S01E01.1080p-GRP",
			Note: "The cleaned name is the name of the download and of its folder. Torrents are never renamed.",
		})
		@PostprocessingOption(PostprocessingOptionProps{
			ID: "underscores-to-dots", Name: "underscores_to_dots", Label: "Dots instead of underscores",
			Help:    "Replaces underscores with dots in the names of the files and folders of a finished download.",
			Checked: v.V["underscores_to_dots"] != "",
			When:    "After unpacking, just before the download is moved to the complete folder (like the replace_for.py category script from the TRaSH guides).",
			Before:  "Show_S01E01_1080p.mkv", After: "Show.S01E01.1080p.mkv",
			Note: "Only NZB downloads. A torrent's files are never renamed, because they are being seeded.",
		})
	}
}
