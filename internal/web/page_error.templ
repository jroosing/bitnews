package web

import "strconv"

// ErrorPage is the standalone error page.
templ ErrorPage(v *View, p errorPage) {
	@BareLayout(v) {
		<div class="card shadow-pop">
			<div class="card-body p-6 text-center sm:p-8">
				<p class="text-5xl font-semibold tracking-tight text-fg-subtle tabular-nums">{ strconv.Itoa(p.Status) }</p>
				<h1 class="mt-3 text-xl">{ p.Heading }</h1>
				<p class="mt-2 text-sm text-fg-muted">{ p.Message }</p>
				<div class="mt-6 flex justify-center gap-2">
					<a href={ templ.URL(p.Href) } class="btn btn-primary">{ p.HrefLabel }</a>
				</div>
			</div>
		</div>
	}
}
