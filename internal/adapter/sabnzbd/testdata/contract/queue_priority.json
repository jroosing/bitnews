{
  "name": "queue priority changes the priority",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "",
  "seed": [
    {
      "op": "download",
      "ref": "d1",
      "name": "one",
      "state": "queued"
    }
  ],
  "steps": [
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&name=priority&value={{nzo.d1}}&value2=2&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": true,
          "position": 0
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "queue": {
            "slots": [
              {
                "nzo_id": "{{nzo.d1}}",
                "priority": "Force"
              }
            ]
          }
        }
      }
    }
  ]
}
