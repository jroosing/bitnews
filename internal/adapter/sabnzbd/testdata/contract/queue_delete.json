{
  "name": "queue delete removes the named download and its working data; unknown ids are ignored",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "Sonarr/Radarr: mode=queue&name=delete&value=<nzo_id>&del_files=1.",
  "seed": [
    {
      "op": "download",
      "ref": "d1",
      "name": "one",
      "state": "queued"
    },
    {
      "op": "download",
      "ref": "d2",
      "name": "two",
      "state": "queued"
    }
  ],
  "steps": [
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&name=delete&value={{nzo.d1}}&del_files=1&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": true,
          "nzo_ids": [
            "{{nzo.d1}}"
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "queue": {
            "noofslots": 1,
            "slots": [
              {
                "nzo_id": "{{nzo.d2}}"
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&name=delete&value=SABnzbd_nzo_doesnotexist&del_files=1&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": true,
          "nzo_ids": []
        }
      }
    }
  ]
}
