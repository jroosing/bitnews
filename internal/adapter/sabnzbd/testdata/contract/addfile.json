{
  "name": "addfile stages the upload and the new Download shows in the queue",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "Sonarr: multipart part 'name' whose filename is the release title + .nzb; cat and priority in the query. -100 is the default priority.",
  "seed": [
    {
      "op": "category",
      "name": "tv"
    }
  ],
  "steps": [
    {
      "name": "upload",
      "request": {
        "method": "POST",
        "target": "/sabnzbd/api?mode=addfile&cat=tv&priority=1&nzbname=Show.S01E01&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "multipart": [
          {
            "name": "name",
            "filename": "Show.S01E01.nzb",
            "content_type": "application/x-nzb",
            "file": "minimal.nzb"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": true,
          "nzo_ids": [
            "$re:^SABnzbd_nzo_[a-z2-7]{26}$"
          ]
        }
      },
      "capture": {
        "nzo": "$.nzo_ids[0]"
      }
    },
    {
      "name": "queue",
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&start=0&limit=30&output=json&apikey={{apikey}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "queue": {
            "noofslots": 1,
            "slots": [
              {
                "nzo_id": "{{nzo}}",
                "filename": "Show.S01E01",
                "cat": "tv",
                "priority": "High",
                "status": "Queued",
                "mb": "0.01"
              }
            ]
          }
        }
      }
    }
  ]
}
