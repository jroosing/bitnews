{
  "name": "addurl fetches the URL, creates an unknown category and returns the nzo_id",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "name is the URL (not URL-encoded here; media managers encode it).",
  "seed": [
    {
      "op": "indexer",
      "file": "minimal.nzb"
    }
  ],
  "steps": [
    {
      "name": "add",
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=addurl&name={{indexer}}/getnzb&cat=movies&nzbname=Some.Movie&priority=-100&output=json&apikey={{apikey}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": true,
          "nzo_ids": [
            "$re:^SABnzbd_nzo_[a-z2-7]{26}$"
          ]
        }
      },
      "capture": {
        "nzo": "$.nzo_ids[0]"
      }
    },
    {
      "name": "queue",
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&output=json&apikey={{apikey}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "queue": {
            "slots": [
              {
                "nzo_id": "{{nzo}}",
                "filename": "Some.Movie",
                "cat": "movies",
                "priority": "Normal",
                "status": "Queued"
              }
            ]
          }
        }
      }
    },
    {
      "name": "categories",
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=get_cats&output=json&apikey={{apikey}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "categories": [
            "*",
            "movies"
          ]
        }
      }
    }
  ]
}
