{
  "name": "start, limit and cat page and filter the queue",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "noofslots counts the filtered queue, noofslots_total the whole queue; index is the place in the whole queue.",
  "seed": [
    {
      "op": "category",
      "name": "tv"
    },
    {
      "op": "category",
      "name": "movies"
    },
    {
      "op": "download",
      "ref": "t1",
      "name": "tv-1",
      "state": "queued",
      "category": "tv"
    },
    {
      "op": "download",
      "ref": "m1",
      "name": "movie-1",
      "state": "queued",
      "category": "movies"
    },
    {
      "op": "download",
      "ref": "t2",
      "name": "tv-2",
      "state": "queued",
      "category": "tv"
    },
    {
      "op": "download",
      "ref": "m2",
      "name": "movie-2",
      "state": "queued",
      "category": "movies"
    },
    {
      "op": "download",
      "ref": "t3",
      "name": "tv-3",
      "state": "queued",
      "category": "tv"
    }
  ],
  "steps": [
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=queue&start=1&limit=1&cat=tv&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "queue": {
            "noofslots": 3,
            "noofslots_total": 5,
            "start": 1,
            "limit": 1,
            "slots": [
              {
                "nzo_id": "{{nzo.t2}}",
                "filename": "tv-2",
                "cat": "tv",
                "index": 2
              }
            ]
          }
        }
      }
    }
  ]
}
