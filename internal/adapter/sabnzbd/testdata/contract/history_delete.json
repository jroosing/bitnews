{
  "name": "history delete removes Ready and Failed downloads",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "Radarr/Sonarr: mode=history&name=delete&value=<nzo_id>&del_files=1; comma-separated ids are accepted.",
  "seed": [
    {
      "op": "download",
      "ref": "ready",
      "name": "r",
      "state": "ready",
      "output_path": "/data/x",
      "added_min": 1
    },
    {
      "op": "download",
      "ref": "failed",
      "name": "f",
      "state": "failed",
      "failure_reason": "internal",
      "added_min": 2
    }
  ],
  "steps": [
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=history&name=delete&value={{nzo.ready}},{{nzo.failed}}&del_files=1&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": true
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=history&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "history": {
            "noofslots": 0,
            "slots": []
          }
        }
      }
    }
  ]
}
