{
  "name": "fullstatus returns a minimal valid status",
  "provenance": "hand-written from the SABnzbd API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M4-01 recordings",
  "description": "",
  "steps": [
    {
      "request": {
        "method": "GET",
        "target": "/sabnzbd/api?mode=fullstatus&skip_dashboard=1&output=json&apikey={{apikey}}",
        "headers": {
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "status": {
            "version": "$re:^\\d+\\.\\d+\\.\\d+$",
            "completedir": "{{complete_dir}}",
            "downloaddir": "{{incomplete_dir}}",
            "paused": false,
            "have_warnings": "0",
            "warnings": []
          }
        }
      }
    }
  ]
}
