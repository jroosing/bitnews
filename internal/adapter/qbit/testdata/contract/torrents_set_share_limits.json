{
  "name": "setShareLimits is accepted",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "seed": [
    {
      "op": "download",
      "ref": "a",
      "name": "Show.A",
      "state": "ready",
      "total": 10,
      "done": 10,
      "output_path": "{{torrent_dir}}/Show.A"
    }
  ],
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "ratio 2, 60 minutes",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/setShareLimits",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}&ratioLimit=2&seedingTimeLimit=60&inactiveSeedingTimeLimit=-2"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "global",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/setShareLimits",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}&ratioLimit=-2&seedingTimeLimit=-2"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "bad number",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/setShareLimits",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}&ratioLimit=abc&seedingTimeLimit=1"
      },
      "response": {
        "status": 400,
        "body": "Bad Request"
      }
    }
  ]
}
