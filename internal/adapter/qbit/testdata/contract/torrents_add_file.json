{
  "name": "grab with a .torrent file, paused",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "add a .torrent file",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/add",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "multipart": [
          {
            "name": "torrents",
            "filename": "Show.S01E01.torrent",
            "content_type": "application/x-bittorrent",
            "file": "minimal.torrent"
          },
          {
            "name": "category",
            "text": "tv-sonarr"
          },
          {
            "name": "paused",
            "text": "true"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": "Ok."
      }
    },
    {
      "name": "paused in the category",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "state": "pausedDL",
            "category": "tv-sonarr"
          }
        ]
      }
    }
  ]
}
