{
  "name": "a cross-site Origin or Sec-Fetch-Site is refused, absent ones are fine",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "cross-site origin",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/createCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded",
          "Origin": "https://evil.example"
        },
        "body": "category=x"
      },
      "response": {
        "status": 401,
        "body": "Unauthorized"
      }
    },
    {
      "name": "cross-site fetch",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/createCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded",
          "Sec-Fetch-Site": "cross-site"
        },
        "body": "category=x"
      },
      "response": {
        "status": 401,
        "body": "Unauthorized"
      }
    },
    {
      "name": "neither (Sonarr)",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/createCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "category=x"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    }
  ]
}
