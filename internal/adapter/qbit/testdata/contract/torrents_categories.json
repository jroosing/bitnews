{
  "name": "categories: create, list, set",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "seed": [
    {
      "op": "category",
      "name": "tv"
    },
    {
      "op": "download",
      "ref": "a",
      "name": "Show.A",
      "state": "queued"
    }
  ],
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "list",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/categories",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "tv": {
            "name": "tv",
            "savePath": "{{torrent_dir}}/tv"
          }
        }
      }
    },
    {
      "name": "create",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/createCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "category=radarr&savePath=%2Fdata%2Ftorrents%2Fmovies"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "invalid name",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/createCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "category=has%20space"
      },
      "response": {
        "status": 409,
        "body": "Incorrect category name"
      }
    },
    {
      "name": "set",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/setCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}&category=radarr"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "set on the torrent",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "hash": "{{hash.a}}",
            "category": "radarr"
          }
        ]
      }
    },
    {
      "name": "unknown category",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/setCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}&category=nothing"
      },
      "response": {
        "status": 409,
        "body": "Category name does not exist"
      }
    },
    {
      "name": "clear",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/setCategory",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}&category="
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "cleared",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "category": ""
          }
        ]
      }
    }
  ]
}
