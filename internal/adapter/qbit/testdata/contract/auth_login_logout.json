{
  "name": "login sets the SID cookie, logout ends it",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "description": "Sonarr/Radarr: POST auth/login with a urlencoded form; the body is 'Ok.' and the SID cookie is HttpOnly, path /. After logout the cookie is dead and every call is 403 Forbidden.",
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "cookie attributes",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Set-Cookie": "$re:^SID=[0-9a-f]{32}; Path=/; HttpOnly; SameSite=Strict$"
        },
        "body": "Ok."
      }
    },
    {
      "name": "version with the cookie",
      "request": {
        "method": "GET",
        "target": "/api/v2/app/version",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "body": "$re:^v\\d+\\.\\d+\\.\\d+$"
      }
    },
    {
      "name": "logout",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/logout",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": ""
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "version after logout",
      "request": {
        "method": "GET",
        "target": "/api/v2/app/version",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 403,
        "body": "Forbidden"
      }
    }
  ]
}
