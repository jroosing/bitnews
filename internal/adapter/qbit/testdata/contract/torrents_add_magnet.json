{
  "name": "grab with a magnet link",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "description": "Sonarr adds a magnet with urls=, category and paused=false. Adding the same torrent twice answers Fails. like qBittorrent.",
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "add",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/add",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "urls=magnet%3A%3Fxt%3Durn%3Abtih%3Ac9e15763f722f23e98a29decdfae341b98d53056%26dn%3DShow.S01E01&category=tv-sonarr&paused=false"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      }
    },
    {
      "name": "it is queued, in the new category",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info?category=tv-sonarr",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "hash": "$re:^[0-9a-f]{40}$",
            "state": "metaDL",
            "category": "tv-sonarr"
          }
        ]
      }
    },
    {
      "name": "the category exists",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/categories",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "tv-sonarr": {
            "name": "tv-sonarr",
            "savePath": "{{torrent_dir}}/tv-sonarr"
          }
        }
      }
    },
    {
      "name": "adding it again fails",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/add",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "urls=magnet%3A%3Fxt%3Durn%3Abtih%3Ac9e15763f722f23e98a29decdfae341b98d53056%26dn%3DShow.S01E01"
      },
      "response": {
        "status": 200,
        "body": "Fails."
      }
    }
  ]
}
