{
  "name": "pause and resume, in both generations of names",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "seed": [
    {
      "op": "download",
      "ref": "a",
      "name": "Show.A",
      "state": "fetching",
      "total": 100,
      "done": 10,
      "down_rate": 5
    }
  ],
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "pause",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/pause",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "paused",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "state": "pausedDL"
          }
        ]
      }
    },
    {
      "name": "resume",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/resume",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes={{hash.a}}"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "downloading again",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "state": "downloading"
          }
        ]
      }
    },
    {
      "name": "stop",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/stop",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes=all"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "stopped means paused here",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "state": "pausedDL"
          }
        ]
      }
    },
    {
      "name": "start",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/start",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "hashes=all"
      },
      "response": {
        "status": 200,
        "body": ""
      }
    },
    {
      "name": "running",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "state": "downloading"
          }
        ]
      }
    }
  ]
}
