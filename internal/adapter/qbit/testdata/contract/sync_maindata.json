{
  "name": "sync/maindata full update",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "seed": [
    {
      "op": "category",
      "name": "tv"
    },
    {
      "op": "download",
      "ref": "a",
      "name": "Show.A",
      "state": "fetching",
      "category": "tv",
      "total": 100,
      "done": 10,
      "down_rate": 5
    }
  ],
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "maindata",
      "request": {
        "method": "GET",
        "target": "/api/v2/sync/maindata?rid=0",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": {
          "rid": 1,
          "full_update": true,
          "torrents": {
            "{{hash.a}}": {
              "state": "downloading",
              "name": "Show.A"
            }
          },
          "categories": {
            "tv": {
              "name": "tv"
            }
          }
        }
      }
    }
  ]
}
