{
  "name": "the Fetched to Ready window never looks complete",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "description": "Sonarr/Radarr must not import before bitnews is done: Fetched and PostProcessing are checkingUP at progress 0.9999. The recorded answer of real Sonarr/Radarr to this (M5-09 key question) is unknown.",
  "seed": [
    {
      "op": "category",
      "name": "tv"
    },
    {
      "op": "download",
      "ref": "fetched",
      "name": "Show.S02E01",
      "state": "fetched",
      "category": "tv",
      "total": 1000,
      "done": 1000,
      "up_rate": 0
    },
    {
      "op": "download",
      "ref": "unpack",
      "name": "Show.S02E02",
      "state": "post_processing",
      "category": "tv",
      "total": 1000,
      "done": 1000,
      "up_rate": 500
    },
    {
      "op": "download",
      "ref": "ready",
      "name": "Show.S02E03",
      "state": "ready",
      "category": "tv",
      "total": 1000,
      "done": 1000,
      "up_rate": 500,
      "uploaded": 2500,
      "seeding_s": 3600,
      "output_path": "{{torrent_dir}}/tv/Show.S02E03",
      "content_path": "{{torrent_dir}}/tv/Show.S02E03",
      "save_path": "{{torrent_dir}}/tv",
      "completed_min": 30
    }
  ],
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "info",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info?category=tv&sort=added_on",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "hash": "{{hash.fetched}}",
            "state": "checkingUP",
            "progress": 0.9999,
            "amount_left": "$type:number",
            "completion_on": -1
          },
          {
            "hash": "{{hash.unpack}}",
            "state": "checkingUP",
            "progress": 0.9999,
            "completion_on": -1
          },
          {
            "hash": "{{hash.ready}}",
            "state": "uploading",
            "progress": 1,
            "amount_left": 0,
            "completed": 1000,
            "ratio": 2.5,
            "uploaded": 2500,
            "seeding_time": 3600,
            "content_path": "{{torrent_dir}}/tv/Show.S02E03",
            "save_path": "{{torrent_dir}}/tv",
            "completion_on": "$type:number"
          }
        ]
      }
    },
    {
      "name": "completed filter lists Ready only",
      "request": {
        "method": "GET",
        "target": "/api/v2/torrents/info?filter=completed",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^application/json"
        },
        "json": [
          {
            "hash": "{{hash.ready}}",
            "state": "uploading"
          }
        ]
      }
    }
  ]
}
