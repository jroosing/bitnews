{
  "name": "add without urls or files fails",
  "provenance": "hand-written from the qBittorrent WebUI API docs and from what Sonarr/Radarr are known to parse; NOT recorded; replace with M5-09 recordings",
  "steps": [
    {
      "name": "login",
      "request": {
        "method": "POST",
        "target": "/api/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "User-Agent": "Sonarr/4.0.0.0"
        },
        "body": "username={{user}}&password={{pass}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "$re:^text/plain"
        },
        "body": "Ok."
      },
      "capture": {
        "sid": "header:Set-Cookie:SID=([^;]+)"
      }
    },
    {
      "name": "add",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/add",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "category=tv"
      },
      "response": {
        "status": 200,
        "body": "Fails."
      }
    },
    {
      "name": "unsupported scheme",
      "request": {
        "method": "POST",
        "target": "/api/v2/torrents/add",
        "headers": {
          "Cookie": "SID={{sid}}",
          "User-Agent": "Sonarr/4.0.0.0",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "urls=file%3A%2F%2F%2Fetc%2Fpasswd"
      },
      "response": {
        "status": 200,
        "body": "Fails."
      }
    }
  ]
}
