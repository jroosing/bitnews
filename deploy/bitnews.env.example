# Optional settings for the systemd service. Install as /etc/bitnews/bitnews.env
# (chmod 640, owner root:root; systemd reads it as root). Read by
# EnvironmentFile=- in bitnews.service.
# Format: KEY=value, one per line, no quotes needed, no variable expansion and
# no systemd specifiers such as %d. Every line below is commented out and shows
# the default. Restart the service after editing: systemctl restart bitnews
#
# Not set here on purpose:
#   BITNEWS_KEY_FILE  the key is created next to the database; see docs/deploy.md
#                     for keeping it elsewhere

# Address for the API, adapters and UI, as host:port. One port serves all.
# Use 127.0.0.1:9494 when a reverse proxy on the same host terminates TLS.
#BITNEWS_LISTEN=0.0.0.0:9494

# TCP and uTP port of the torrent engine. Forward it on your router: bitnews
# does no UPnP. Open it in the firewall for TCP and UDP.
#BITNEWS_TORRENT_PORT=51413

# Directory that holds bitnews.db and the master key (bitnews.key). Must be an
# absolute path. Keep it in sync with StateDirectory= in the unit.
#BITNEWS_CONFIG_DIR=/var/lib/bitnews

# debug, info, warn or error
#BITNEWS_LOG_LEVEL=info

# text or json (json suits log shippers; journald is fine with text)
#BITNEWS_LOG_FORMAT=text

# File creation mask, octal. 002 makes new files group-writable, so Sonarr and
# Radarr running as another user in the same group can manage them. The unit
# already sets UMask=0002; this applies the same value inside the process.
#UMASK=002

# Create the admin non-interactively instead of through the setup screen.
# Absolute path of a file holding the password. Prefer a LoadCredential=
# line in a drop-in over a world-readable file (see docs/deploy.md).
#BITNEWS_ADMIN_PASSWORD_FILE=
